{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "salary sense",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../.next",
    "devUrl": "http://localhost:3000/apppages/dashboard",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Salary sense",
        "resizable": false,
        "fullscreen": true,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
